# ======================================================================
# DeedsPlan — Apache config cho htdocs/ trên InfinityFree (deedsteam.click)
# Đặt tên file: .htaccess ở THƯ MỤC GỐC htdocs/
# ======================================================================

Options -MultiViews +FollowSymLinks
RewriteEngine On
RewriteBase /

# --- HTTPS force (SSL miễn phí của InfinityFree đã bật tại domain) ---
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# --- API: route /api/<path> → api/index.php?route=<path> ---
RewriteCond %{REQUEST_URI} !^/api/index\.php
RewriteRule ^api/(.+)$ api/index.php?route=$1 [QSA,L]

# --- SPA fallback: mọi URL không phải file thật → index.html ---
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# --- Bảo mật ---
<FilesMatch "^(config\.php|\.env|schema\.sql)$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- Nén & cache (InfinityFree hỗ trợ deflate; expires có thể bị limit) ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"
  <FilesMatch "\.(js|css|woff2|svg|png)$">
    # Vite đã hash filename → cache dài an toàn
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# PHP on shared host: tăng giới hạn upload/payload nếu được phép
<IfModule mod_php.c>
  php_value upload_max_filesize 4M
  php_value post_max_size 8M
  php_value memory_limit 256M
</IfModule>

DirectoryIndex index.html index.php
