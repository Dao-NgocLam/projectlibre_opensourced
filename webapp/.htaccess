# ======================================================================
# DeedsPlan — Apache config cho htdocs/ trên InfinityFree (deedsteam.click)
# Đặt tên file: .htaccess ở THƯ MỤC GỐC htdocs/
# ======================================================================

Options -MultiViews +FollowSymLinks
RewriteEngine On
RewriteBase /

# --- HTTPS force (SSL miễn phí của InfinityFree đã bật tại domain) ---
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# =====================================================================
# CLOUDFLARE FRONT-DOOR — chỉ chấp nhận request đi qua proxy Cloudflare.
# Nếu REMOTE_ADDR KHÔNG thuộc dải IP CF → 403 ngay tại Apache (rẻ hơn PHP).
# Lưu ý: lớp PHP enforce_cloudflare_only() vẫn chạy song song (defense-in-depth).
# Khi dev local (không qua CF), comment khối này lại hoặc đặt env development.
# =====================================================================
<IfModule mod_rewrite.c>
  RewriteCond %{REMOTE_ADDR} !^173\.245\.(4[89]|5[0-5])\.
  RewriteCond %{REMOTE_ADDR} !^103\.21\.24[4-7]\.
  RewriteCond %{REMOTE_ADDR} !^103\.22\.20[0-3]\.
  RewriteCond %{REMOTE_ADDR} !^103\.31\.4\.
  RewriteCond %{REMOTE_ADDR} !^141\.101\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.
  RewriteCond %{REMOTE_ADDR} !^108\.162\.(19[2-9]|2[0-5][0-5])\.
  RewriteCond %{REMOTE_ADDR} !^190\.93\.24[0-7]\.
  RewriteCond %{REMOTE_ADDR} !^188\.114\.9[6-9]\.|^188\.114\.10[0-9]\.|^188\.114\.11[0-1]\.
  RewriteCond %{REMOTE_ADDR} !^197\.234\.24[0-3]\.
  RewriteCond %{REMOTE_ADDR} !^198\.41\.(12[8-9]|1[3-9][0-9]|[0-9][0-9])\.
  RewriteCond %{REMOTE_ADDR} !^162\.15[89]\.
  RewriteCond %{REMOTE_ADDR} !^104\.(1[6-9]|2[0-9]|3[0-9])\.|^104\.(4[0-9]|5[0-9]|6[0-3])\.
  RewriteCond %{REMOTE_ADDR} !^104\.2[4-9]\.|^104\.3[0-1]\.
  RewriteCond %{REMOTE_ADDR} !^172\.6[4-9]\.|^172\.7[0-1]\.
  RewriteCond %{REMOTE_ADDR} !^131\.0\.72\.
  RewriteRule .* - [F,L]
</IfModule>

# --- API: route /api/<path> → api/index.php?route=<path> ---
RewriteCond %{REQUEST_URI} !^/api/index\.php
RewriteRule ^api/(.+)$ api/index.php?route=$1 [QSA,L]

# --- SPA fallback: mọi URL không phải file thật → index.html ---
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# --- Bảo mật header (song song với Cloudflare dashboard → xem docs/cloudflare_integration.md) ---
<FilesMatch "^(config\.php|\.env|schema\.sql|security\.php)$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # CSP khớp với emit_security_headers() trong api/lib/security.php
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
  # HSTS — Cloudflare cũng bật Separate; đặt cả hai để phòng khi bypass CF
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
  # Ẩn version Apache/PHP
  Header unset X-Powered-By
</IfModule>
ServerTokens Prod
ServerSignature Off

# --- Nén & cache (InfinityFree hỗ trợ deflate; expires có thể bị limit) ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"
  <FilesMatch "\.(js|css|woff2|svg|png)$">
    # Vite đã hash filename → cache dài an toàn
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# PHP on shared host: tăng giới hạn upload/payload nếu được phép
<IfModule mod_php.c>
  php_value upload_max_filesize 4M
  php_value post_max_size 8M
  php_value memory_limit 256M
</IfModule>

DirectoryIndex index.html index.php
